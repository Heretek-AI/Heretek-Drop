import { Button } from "std-widgets.slint";

export component SettingsPage inherits Rectangle {
    in-out property <string> server-url: "";
    in-out property <string> download-dir: "";
    in-out property <int> max-concurrent: 2;
    in-out property <string> theme: "auto";
    in-out property <bool> auto-start: false;

    background: #1e1e1e;

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "Settings";
                color: #ffffff;
                font-size: 22px;
                font-weight: 600;
            }

            // Server
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Server";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                Rectangle {
                    height: 32px;
                    background: #2a2a2a;
                    border-radius: 4px;
                    Text {
                        text: root.server-url;
                        color: #ffffff;
                        padding: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            // Downloads
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Downloads";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        background: #2a2a2a;
                        border-radius: 4px;
                        Text {
                            text: root.download-dir;
                            color: #ffffff;
                            padding: 8px;
                            vertical-alignment: center;
                        }
                    }
                    Button {
                        text: "Browse...";
                    }
                }
            }

            // Behavior
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Behavior";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    Text {
                        text: "Auto-start on login";
                        color: #ffffff;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }

            // Theme
            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Theme";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.theme == "auto" ? "Auto (selected)" : "Auto";
                        clicked => { root.theme = "auto"; }
                    }
                    Button {
                        text: root.theme == "light" ? "Light (selected)" : "Light";
                        clicked => { root.theme = "light"; }
                    }
                    Button {
                        text: root.theme == "dark" ? "Dark (selected)" : "Dark";
                        clicked => { root.theme = "dark"; }
                    }
                }
            }

            // Sign out
            Rectangle {
                height: 1px;
                background: #3a3a3a;
            }
            Button {
                text: "Sign out";
                clicked => {
                }
            }
        }
    }
}
