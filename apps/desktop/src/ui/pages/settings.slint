import { Button, ScrollView } from "std-widgets.slint";

export component SettingsPage inherits Rectangle {
    in-out property <string> server-url: "https://drop.example.com";
    in-out property <string> download-dir: "~/Games/Heretek-Drop";
    in-out property <int> max-concurrent: 2;
    in-out property <string> theme: "auto";
    in-out property <bool> auto-start: false;

    callback sign-out();
    callback browse-download-dir();
    callback theme-changed(string);

    background: #1e1e1e;

    ScrollView {
        VerticalLayout {
            padding: 24px;
            spacing: 16px;

            Text {
                text: "Settings";
                color: #ffffff;
                font-size: 22px;
                font-weight: 600;
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Server";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                Rectangle {
                    height: 32px;
                    background: #2a2a2a;
                    border-radius: 4px;
                    Text {
                        text: root.server-url;
                        color: #ffffff;
                        padding: 8px;
                        vertical-alignment: center;
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Downloads";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 32px;
                        background: #2a2a2a;
                        border-radius: 4px;
                        Text {
                            text: root.download-dir;
                            color: #ffffff;
                            padding: 8px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Button {
                        text: "Browse...";
                        clicked => { root.browse-download-dir(); }
                    }
                }
            }

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: "Theme";
                    color: #aaaaaa;
                    font-size: 13px;
                    font-weight: 600;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.theme == "auto" ? "Auto ✓" : "Auto";
                        clicked => { root.theme-changed("auto"); }
                    }
                    Button {
                        text: root.theme == "light" ? "Light ✓" : "Light";
                        clicked => { root.theme-changed("light"); }
                    }
                    Button {
                        text: root.theme == "dark" ? "Dark ✓" : "Dark";
                        clicked => { root.theme-changed("dark"); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #3a3a3a;
            }
            Button {
                text: "Sign out";
                clicked => { root.sign-out(); }
            }
        }
    }
}
