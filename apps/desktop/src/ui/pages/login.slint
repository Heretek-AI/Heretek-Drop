import { Button } from "std-widgets.slint";

export component LoginPage inherits Rectangle {
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> error: "";
    in-out property <string> login-error: "";
    in-out property <bool> is-loading: false;

    callback login(string, string);

    background: #1e1e1e;

    VerticalLayout {
        alignment: center;
        spacing: 16px;
        padding: 32px;

        Text {
            text: "Sign in to Drop";
            color: #ffffff;
            font-size: 24px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: "Click the button below to open the Drop auth page in your browser.";
            color: #888888;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        if root.error != "" || root.login-error != "": Text {
            text: root.error != "" ? root.error : root.login-error;
            color: #ff4444;
            font-size: 12px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }

        Button {
            text: root.is-loading ? "Opening browser..." : "Sign in via browser";
            primary: true;
            enabled: !root.is-loading;
            clicked => {
                root.login(root.username, root.password);
            }
        }
    }
}
