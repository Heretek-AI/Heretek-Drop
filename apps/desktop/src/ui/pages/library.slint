import { Button } from "std-widgets.slint";

export struct Game {
    id: int,
    title: string,
    developer: string,
    cover-image: image,
}

export component LibraryPage inherits Rectangle {
    in-out property <[Game]> games: [];
    in-out property <string> search-query: "";
    in-out property <bool> is-loading: false;

    callback refresh();
    callback download-game(int);

    background: #1e1e1e;

    VerticalLayout {
        padding: 16px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "My Library";
                color: #ffffff;
                font-size: 22px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Button {
                text: "Refresh";
                clicked => { root.refresh(); }
            }
        }

        if root.is-loading: Text {
            text: "Loading...";
            color: #888888;
            horizontal-alignment: center;
        }

        if !root.is-loading && root.games.length == 0: VerticalLayout {
            alignment: center;
            spacing: 12px;
            Text {
                text: "No games in your library yet.";
                color: #888888;
                horizontal-alignment: center;
            }
            Text {
                text: "Sign in and click Refresh to load your games.";
                color: #666666;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }

        for game in root.games: Rectangle {
            background: #2a2a2a;
            border-radius: 4px;
            height: 80px;
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                Rectangle {
                    width: 56px;
                    height: 56px;
                    background: #1a1a1a;
                    border-radius: 4px;
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;
                    Text {
                        text: game.title;
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                    }
                    Text {
                        text: game.developer;
                        color: #888888;
                        font-size: 11px;
                        overflow: elide;
                    }
                }
                Button {
                    text: "Download";
                    clicked => { root.download-game(game.id); }
                }
            }
        }
    }
}
